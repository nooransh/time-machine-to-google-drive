#!/bin/bash
#
# tm2gdrive - use Google Drive as a Time Machine backup disk.
#
# How it works (details in README.md):
#   * rclone serves a Google Drive folder over NFS on 127.0.0.1, and macOS
#     mounts it with its built-in NFS client (no kernel extensions, no VM).
#   * On that mount lives an encrypted APFS disk image (a sparse bundle, stored
#     as many small "band" files). It is attached as a normal disk called
#     "Google Drive Backup", and Time Machine backs up to it every hour.
#   * Writes land in a local cache first and are uploaded in the background;
#     anything not yet uploaded survives restarts and is uploaded later.
#   * A LaunchDaemon keeps all of this running across reboots and sleep.
#
# https://github.com/nooranshdhaka/time-machine-to-google-drive
#
# Written for the bash 3.2 that ships with macOS.

set -o pipefail

VERSION="2.0.0"
PROG="tm2gdrive"
LABEL="io.github.nooranshdhaka.tm2gdrive"

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# ---------------------------------------------------------------------------
# Locations (the TM2GDRIVE_* overrides exist for the test suite)
# ---------------------------------------------------------------------------
STATE_DIR="${TM2GDRIVE_STATE_DIR:-/Library/Application Support/tm2gdrive}"
CACHE_DIR="${TM2GDRIVE_CACHE_DIR:-/Library/Caches/tm2gdrive}"
DRIVE_MNT="${TM2GDRIVE_DRIVE_MNT:-/private/var/tm2gdrive/drive}"
LOG_FILE="${TM2GDRIVE_LOG:-/Library/Logs/tm2gdrive.log}"
PLIST="${TM2GDRIVE_PLIST:-/Library/LaunchDaemons/$LABEL.plist}"

CONFIG_FILE="$STATE_DIR/config"
RCLONE_CONF="$STATE_DIR/rclone.conf"
PASSWORD_FILE="$STATE_DIR/disk-password"
RC_SOCKET="$STATE_DIR/rc.sock"
BIN_DIR="$STATE_DIR/bin"            # root-owned copies of tm2gdrive and rclone, run by the service
IMAGE_NAME="TimeMachine.sparsebundle"
IMAGE="$DRIVE_MNT/$IMAGE_NAME"

# ---------------------------------------------------------------------------
# Settings (override in $CONFIG_FILE)
# ---------------------------------------------------------------------------
SETTINGS="RCLONE_REMOTE DRIVE_FOLDER VOLUME_NAME DISK_SIZE_GB CACHE_MAX_GB CACHE_MIN_FREE_GB NFS_PORT TRANSFERS BWLIMIT"
NUMERIC_SETTINGS="DISK_SIZE_GB CACHE_MAX_GB CACHE_MIN_FREE_GB NFS_PORT TRANSFERS"

RCLONE_REMOTE="gdrive"                 # rclone remote name (in $RCLONE_CONF)
DRIVE_FOLDER="tm2gdrive"               # Google Drive folder that holds the backup disk
VOLUME_NAME="Google Drive Backup"      # name of the backup disk in Finder and Time Machine
DISK_SIZE_GB=0                         # maximum size of the backup disk; 0 = chosen at setup
CACHE_MAX_GB=50                        # local cache of already-uploaded data, for speed
CACHE_MIN_FREE_GB=20                   # keep at least this much free space on the Mac
NFS_PORT=52049                         # local port of the NFS server (127.0.0.1 only)
TRANSFERS=8                            # parallel uploads
BWLIMIT=""                             # optional bandwidth limit, e.g. "20M" (rclone --bwlimit)

BAND_SECTORS=32768                     # 16 MiB bands: few files for Drive, small re-uploads

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_BLU=$'\033[34m'; C_BLD=$'\033[1m'; C_OFF=$'\033[0m'
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BLU=""; C_BLD=""; C_OFF=""
fi

info() { printf '%s==>%s %s\n' "$C_BLU" "$C_OFF" "$*"; }
ok()   { printf '%s✔%s %s\n' "$C_GRN" "$C_OFF" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; }
err()  { printf '%s✘ %s%s\n' "$C_RED" "$*" "$C_OFF" >&2; }
die()  { err "$*"; exit 1; }
log()  { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }   # service: stdout is the log file

# Returns 0 for yes, 1 for no, 2 if there is no input at all.
confirm() {
    local reply
    [[ -n "$TM2GDRIVE_ASSUME_YES" ]] && return 0
    printf '%s [y/N] ' "$1"
    read -r reply || return 2
    [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]]
}

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

# Reads KEY=value lines. The file is parsed, never executed (it is read as root).
read_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    local line key val
    local re_skip='^[[:space:]]*(#.*)?$' re_kv='^[[:space:]]*([A-Z_]+)[[:space:]]*=(.*)$'
    local re_dq='^"([^"]*)"' re_sq="^'([^']*)'"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ $re_skip ]] && continue
        if [[ ! "$line" =~ $re_kv ]]; then
            warn "Ignoring unreadable line in $CONFIG_FILE: $line"
            continue
        fi
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        val="${val#"${val%%[![:space:]]*}"}"
        if [[ "$val" =~ $re_dq || "$val" =~ $re_sq ]]; then
            val="${BASH_REMATCH[1]}"
        else
            val="${val%%#*}"
            val="${val%"${val##*[![:space:]]}"}"
        fi
        case " $SETTINGS " in
            *" $key "*) eval "$key=\$val" ;;
            *) warn "Unknown setting in $CONFIG_FILE: $key" ;;
        esac
    done < "$CONFIG_FILE"
}

load_config() {
    read_config
    local key
    for key in $NUMERIC_SETTINGS; do
        [[ "${!key}" =~ ^[0-9]+$ ]] || die "$key in $CONFIG_FILE must be a whole number."
    done
    [[ -n "$VOLUME_NAME" && "$VOLUME_NAME" != */* ]] || die "VOLUME_NAME in $CONFIG_FILE is not a valid disk name."
    VOLUME="/Volumes/$VOLUME_NAME"
}

write_config() {
    cat > "$CONFIG_FILE" <<EOF
# tm2gdrive settings. See "Settings" in README.md.
# After editing, restart the service: sudo tm2gdrive restart
RCLONE_REMOTE="$RCLONE_REMOTE"
DRIVE_FOLDER="$DRIVE_FOLDER"
VOLUME_NAME="$VOLUME_NAME"
DISK_SIZE_GB=$DISK_SIZE_GB
CACHE_MAX_GB=$CACHE_MAX_GB
CACHE_MIN_FREE_GB=$CACHE_MIN_FREE_GB
NFS_PORT=$NFS_PORT
TRANSFERS=$TRANSFERS
BWLIMIT="$BWLIMIT"
EOF
    chmod 600 "$CONFIG_FILE"
}

# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------
require_macos() {
    [[ "$(uname -s)" == "Darwin" ]] || die "$PROG runs on macOS."
}

require_root() {
    [[ $EUID -eq 0 ]] || die "This needs administrator rights. Run: sudo $PROG $*"
}

# Re-runs this script as root.
ensure_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo "$0" "$@"
    fi
}

require_setup() {
    [[ -f "$CONFIG_FILE" && -f "$RCLONE_CONF" ]] || die "$PROG is not set up yet. Run: $PROG setup"
}

# rclone 1.65+ has "serve nfs". $1 = the rclone command to ask.
rclone_ok() {
    local v major minor
    v=$("$1" version 2>/dev/null | awk 'NR == 1 { sub(/^v/, "", $2); print $2 }')
    major=${v%%.*}; minor=${v#*.}; minor=${minor%%.*}
    [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
    [[ $major -gt 1 || $minor -ge 65 ]]
}

# ---------------------------------------------------------------------------
# State helpers
# ---------------------------------------------------------------------------
# Output is captured before matching: with pipefail, "cmd | grep -q" can report
# a failure when grep stops reading early.
drive_mounted()  { [[ "$(mount)" == *" on $DRIVE_MNT (nfs"* ]]; }
disk_attached()  { [[ "$(hdiutil info 2>/dev/null)" == *"$IMAGE"* ]]; }
volume_mounted() { [[ "$(mount)" == *" on $VOLUME ("* ]]; }
tm_running()     { [[ "$(tmutil status 2>/dev/null)" == *"Running = 1"* ]]; }
service_loaded() { launchctl print "system/$LABEL" >/dev/null 2>&1; }

rclone_bin() {
    if [[ -x "$BIN_DIR/rclone" ]]; then echo "$BIN_DIR/rclone"; else command -v rclone; fi
}

rc() {
    "$(rclone_bin)" rc --unix-socket "$RC_SOCKET" "$@" 2>/dev/null
}

# Files waiting to be uploaded (in progress + queued); empty if unknown.
pending_uploads() {
    local stats a b
    stats=$(rc vfs/stats) || return 0
    a=$(printf '%s' "$stats" | grep -oE '"uploadsInProgress":[[:space:]]*[0-9]+' | grep -oE '[0-9]+$')
    b=$(printf '%s' "$stats" | grep -oE '"uploadsQueued":[[:space:]]*[0-9]+' | grep -oE '[0-9]+$')
    [[ -n "$a" && -n "$b" ]] && echo $((a + b))
}

drive_free_bytes() {
    "$(rclone_bin)" --config "$RCLONE_CONF" about "${RCLONE_REMOTE}:" --json 2>/dev/null \
        | grep -oE '"free":[[:space:]]*[0-9]+' | grep -oE '[0-9]+$'
}

human_gb() { awk -v b="$1" 'BEGIN { printf "%.0f GB", b / 1000000000 }'; }

# Time Machine destination ID whose mount point is our backup disk.
tm_destination_id() {
    tmutil destinationinfo 2>/dev/null | awk -v m="$VOLUME" '
        /^====/ { if (found && id != "") { print id; done = 1; exit } id = ""; found = 0; next }
        /^ID/ { sub(/^ID[[:space:]]*:[[:space:]]*/, ""); id = $0 }
        /^Mount Point/ { sub(/^Mount Point[[:space:]]*:[[:space:]]*/, ""); if ($0 == m) found = 1 }
        END { if (!done && found && id != "") print id }'
}

wait_for() {   # wait_for <seconds> <command...>
    local t="$1" _
    shift
    for _ in $(seq 1 "$t"); do
        "$@" && return 0
        sleep 1
    done
    return 1
}

# ---------------------------------------------------------------------------
# The background service (runs as root under launchd)
# ---------------------------------------------------------------------------
SERVER_PID=""

# An rclone left running by a crashed service would hold the port.
kill_stale_server() {
    local pids
    pids=$(lsof -nP -t -iTCP:"$NFS_PORT" -sTCP:LISTEN 2>/dev/null)
    [[ -n "$pids" ]] || return 0
    log "stopping a leftover NFS server (pid $pids)"
    local pid
    for pid in $pids; do kill -TERM "$pid" 2>/dev/null; done
    # shellcheck disable=SC2016  # evaluated later by wait_for
    if ! wait_for 30 eval '[[ -z "$(lsof -nP -t -iTCP:"$NFS_PORT" -sTCP:LISTEN 2>/dev/null)" ]]'; then
        for pid in $pids; do kill -KILL "$pid" 2>/dev/null; done
    fi
}

start_server() {
    local args=(
        serve nfs "${RCLONE_REMOTE}:${DRIVE_FOLDER}"
        --addr "127.0.0.1:$NFS_PORT"
        --config "$RCLONE_CONF"
        --cache-dir "$CACHE_DIR"
        --vfs-cache-mode full
        --vfs-cache-max-size "${CACHE_MAX_GB}G"
        --vfs-cache-min-free-space "${CACHE_MIN_FREE_GB}G"
        --vfs-cache-max-age 8760h
        --vfs-write-back 30s
        --dir-cache-time 8760h
        --nfs-cache-type disk
        --nfs-cache-dir "$CACHE_DIR/nfs-handles"
        --transfers "$TRANSFERS"
        --drive-chunk-size 64M
        --drive-use-trash=false
        --rc --rc-addr "unix://$RC_SOCKET" --rc-no-auth
        --log-level NOTICE
    )
    [[ -n "$BWLIMIT" ]] && args+=(--bwlimit "$BWLIMIT")
    rm -f "$RC_SOCKET"
    "$(rclone_bin)" "${args[@]}" &
    SERVER_PID=$!
    log "started the rclone NFS server (pid $SERVER_PID) for ${RCLONE_REMOTE}:${DRIVE_FOLDER}"
    local _
    for _ in $(seq 1 60); do
        nc -z 127.0.0.1 "$NFS_PORT" 2>/dev/null && return 0
        kill -0 "$SERVER_PID" 2>/dev/null || { log "rclone exited during startup"; return 1; }
        sleep 1
    done
    log "the rclone NFS server did not start listening"
    return 1
}

mount_drive() {
    mkdir -p "$DRIVE_MNT"
    # "hard": if rclone restarts, I/O waits for it instead of failing, so the
    # disk image on top never sees errors. "locallocks": rclone has no NFS lock daemon.
    if mount -t nfs -o "port=$NFS_PORT,mountport=$NFS_PORT,tcp,vers=3,locallocks,hard,intr" \
        "127.0.0.1:/" "$DRIVE_MNT"; then
        log "mounted the Google Drive folder at $DRIVE_MNT"
    else
        log "could not mount the NFS share"
        return 1
    fi
}

attach_disk() {
    [[ -f "$PASSWORD_FILE" ]] || { log "no disk password stored; run setup"; return 1; }
    mkdir -p "$VOLUME"
    if tr -d '\n' < "$PASSWORD_FILE" | hdiutil attach -stdinpass -owners on -noverify -noautoopen \
        -mountpoint "$VOLUME" "$IMAGE" >/dev/null; then
        # Time Machine needs file ownership on its disk; images on network
        # storage are attached without it.
        diskutil enableOwnership "$VOLUME" >/dev/null 2>&1 || log "could not enable ownership on $VOLUME"
        log "attached the backup disk at $VOLUME"
    else
        log "could not attach $IMAGE"
        rmdir "$VOLUME" 2>/dev/null
        return 1
    fi
}

detach_disk() {
    disk_attached || return 0
    if tm_running; then
        log "stopping the running Time Machine backup before detaching"
        tmutil stopbackup 2>/dev/null
        sleep 5
    fi
    hdiutil detach "$VOLUME" >/dev/null 2>&1 \
        || { sleep 5; hdiutil detach "$VOLUME" >/dev/null 2>&1; } \
        || hdiutil detach -force "$VOLUME" >/dev/null 2>&1
    log "detached the backup disk"
}

stop_everything() {
    log "stopping"
    detach_disk
    if drive_mounted; then umount "$DRIVE_MNT" 2>/dev/null || umount -f "$DRIVE_MNT" 2>/dev/null; fi
    if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
        kill -TERM "$SERVER_PID" 2>/dev/null
        # shellcheck disable=SC2016  # evaluated later by wait_for
        wait_for 30 eval '! kill -0 "$SERVER_PID" 2>/dev/null' || kill -KILL "$SERVER_PID" 2>/dev/null
    fi
    log "stopped (files not yet uploaded are kept and uploaded on the next start)"
}

cmd_daemon() {
    require_root daemon
    load_config
    mkdir -p "$CACHE_DIR" "$DRIVE_MNT"
    trap 'stop_everything; exit 0' TERM INT HUP
    log "$PROG $VERSION service starting"
    kill_stale_server

    local said_missing=""
    while :; do
        if [[ -z "$SERVER_PID" ]] || ! kill -0 "$SERVER_PID" 2>/dev/null; then
            [[ -n "$SERVER_PID" ]] && log "rclone stopped unexpectedly; restarting it (the mount reconnects by itself)"
            start_server || { sleep 10 & wait $!; continue; }
        fi
        if ! drive_mounted; then
            mount_drive || { sleep 10 & wait $!; continue; }
        fi
        if ! disk_attached; then
            if [[ -d "$IMAGE" ]]; then
                attach_disk
                said_missing=""
            elif [[ -z "$said_missing" ]]; then
                log "no backup disk in the Drive folder yet (setup creates it)"
                said_missing=1
            fi
        fi
        sleep 10 & wait $!
    done
}

# ---------------------------------------------------------------------------
# Service management
# ---------------------------------------------------------------------------
write_plist() {
    local extra_env="" v
    for v in TM2GDRIVE_STATE_DIR TM2GDRIVE_CACHE_DIR TM2GDRIVE_DRIVE_MNT TM2GDRIVE_LOG TM2GDRIVE_PLIST; do
        [[ -n "${!v:-}" ]] && extra_env="$extra_env
        <key>$v</key><string>${!v}</string>"
    done
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$BIN_DIR/tm2gdrive</string>
        <string>daemon</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>$extra_env
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ExitTimeOut</key>
    <integer>120</integer>
    <key>StandardOutPath</key>
    <string>$LOG_FILE</string>
    <key>StandardErrorPath</key>
    <string>$LOG_FILE</string>
</dict>
</plist>
EOF
    chown root:wheel "$PLIST"
    chmod 644 "$PLIST"
}

# The service runs as root, so it only runs root-owned copies of its programs
# (Homebrew's folders are writable by the user).
install_binaries() {
    local self rclone_path
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    rclone_path=$(command -v rclone) || die "rclone is not installed. Run: brew install rclone"
    mkdir -p "$BIN_DIR"
    if ! { install -m 755 -o root -g wheel "$self" "$BIN_DIR/tm2gdrive.new" \
           && mv -f "$BIN_DIR/tm2gdrive.new" "$BIN_DIR/tm2gdrive" \
           && install -m 755 -o root -g wheel "$rclone_path" "$BIN_DIR/rclone.new" \
           && mv -f "$BIN_DIR/rclone.new" "$BIN_DIR/rclone"; }; then
        die "Could not install the service."
    fi
}

service_start() {
    service_loaded && return 0
    launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load -w "$PLIST"
}

service_stop() {
    service_loaded || return 0
    launchctl bootout "system/$LABEL" 2>/dev/null || launchctl unload "$PLIST" 2>/dev/null
    wait_for 130 eval '! service_loaded'
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# Part 1 (as the user): Google sign-in, which needs the user's browser.
cmd_setup() {
    local client_id="" client_secret=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --client-id)     client_id="$2"; shift ;;
            --client-secret) client_secret="$2"; shift ;;
            *) die "Unknown option for setup: $1" ;;
        esac
        shift
    done
    require_macos
    [[ $EUID -eq 0 && -n "$SUDO_USER" ]] && die "Run setup as your normal user, without sudo."

    echo "${C_BLD}$PROG setup${C_OFF}: Time Machine backups to Google Drive"
    echo

    if ! command -v rclone >/dev/null 2>&1; then
        command -v brew >/dev/null 2>&1 || die "Install Homebrew (https://brew.sh), then run: brew install rclone"
        info "Installing rclone..."
        brew install rclone || die "Could not install rclone."
    fi
    rclone_ok rclone || die "rclone is too old. Run: brew upgrade rclone"
    ok "$(rclone version | head -1)"

    info "Administrator rights are needed to install the background service."
    sudo -v || die "Administrator rights are required."

    local conf=""
    if [[ -n "$TM2GDRIVE_RCLONE_CONF" ]]; then
        conf="$TM2GDRIVE_RCLONE_CONF"
    elif sudo test -f "$RCLONE_CONF"; then
        ok "Already signed in to Google Drive"
    else
        echo
        echo "${C_BLD}Sign in to Google Drive${C_OFF}"
        echo "Use the client ID and secret you created (README.md, step 2)."
        [[ -n "$client_id" ]] || { printf 'Client ID: '; read -r client_id; }
        [[ -n "$client_secret" ]] || { printf 'Client secret: '; read -r client_secret; }
        [[ -n "$client_id" && -n "$client_secret" ]] || die "Client ID and secret are required."
        conf=$(mktemp -t tm2gdrive-rclone) || die "Could not create a temporary file."
        info "A browser window will open. Sign in with the Google account that should hold the backups."
        info "If Google says it hasn't verified the app, click Advanced, then Go to tm2gdrive (it's your own app)."
        RCLONE_CONFIG="$conf" rclone config create "$RCLONE_REMOTE" drive \
            client_id="$client_id" client_secret="$client_secret" scope=drive.file >/dev/null \
            || { rm -f "$conf"; die "Signing in to Google Drive failed."; }
        RCLONE_CONFIG="$conf" rclone lsd "${RCLONE_REMOTE}:" >/dev/null 2>&1 \
            || { rm -f "$conf"; die "Signed in, but Google Drive can't be reached."; }
        ok "Signed in to Google Drive"
    fi

    # Part 2 runs as root. sudo drops the environment, so pass the test hooks on.
    local envs=() v rc
    for v in TM2GDRIVE_STATE_DIR TM2GDRIVE_CACHE_DIR TM2GDRIVE_DRIVE_MNT TM2GDRIVE_LOG TM2GDRIVE_PLIST \
             TM2GDRIVE_DISK_PASSWORD TM2GDRIVE_DISK_SIZE_GB TM2GDRIVE_DRIVE_FOLDER TM2GDRIVE_ASSUME_YES \
             TM2GDRIVE_SKIP_TIME_MACHINE; do
        [[ -n "${!v:-}" ]] && envs+=("$v=${!v}")
    done
    sudo env ${envs[@]+"${envs[@]}"} /bin/bash "$0" _setup-root "$conf"
    rc=$?
    [[ -n "$conf" && "$conf" != "$TM2GDRIVE_RCLONE_CONF" ]] && rm -f "$conf"
    return $rc
}

# Size for a new backup disk: twice the Mac's data, within what Drive can hold.
choose_disk_size() {
    local free="$1" need_b="$2" size cap
    size=$(( need_b * 2 / 1000000000 ))
    [[ $size -lt 200 ]] && size=200
    if [[ -n "$free" ]]; then
        cap=$(( free * 9 / 10 / 1000000000 ))
        [[ $size -gt $cap ]] && size=$cap
    fi
    # 16 MiB bands keep a 7 TB disk under Drive's 500,000 files per folder.
    [[ $size -gt 7000 ]] && size=7000
    echo "$size"
}

# Part 2 (as root): service, backup disk, Time Machine.
cmd_setup_root() {
    local conf="$1"
    require_macos; require_root setup
    load_config
    umask 077
    mkdir -p "$STATE_DIR" "$CACHE_DIR"
    chmod 700 "$STATE_DIR"
    [[ -n "$TM2GDRIVE_DRIVE_FOLDER" ]] && DRIVE_FOLDER="$TM2GDRIVE_DRIVE_FOLDER"
    if [[ -n "$conf" ]]; then
        install -m 600 -o root -g wheel "$conf" "$RCLONE_CONF" || die "Could not save the Google sign-in."
    fi
    [[ -f "$RCLONE_CONF" ]] || die "Not signed in to Google Drive. Run $PROG setup again."

    local free used_kb need_b
    free=$(rclone --config "$RCLONE_CONF" about "${RCLONE_REMOTE}:" --json 2>/dev/null \
        | grep -oE '"free":[[:space:]]*[0-9]+' | grep -oE '[0-9]+$')
    used_kb=$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR == 2 { print $3 }')
    [[ "$used_kb" =~ ^[0-9]+$ ]] || used_kb=$(df -k / | awk 'NR == 2 { print $3 }')
    need_b=$((used_kb * 1024))
    [[ -n "$free" ]] && info "Google Drive has $(human_gb "$free") free. This Mac holds $(human_gb "$need_b") of data."
    if [[ -n "$TM2GDRIVE_DISK_SIZE_GB" ]]; then
        DISK_SIZE_GB="$TM2GDRIVE_DISK_SIZE_GB"
    elif [[ "$DISK_SIZE_GB" -eq 0 ]]; then
        DISK_SIZE_GB=$(choose_disk_size "$free" "$need_b")
    fi
    [[ $DISK_SIZE_GB -ge 1 ]] || die "Not enough free space in Google Drive."
    write_config

    # The first backup is written to the local cache faster than it uploads.
    local local_free_kb
    local_free_kb=$(df -k "$(dirname "$CACHE_DIR")" | awk 'NR == 2 { print $4 }')
    if [[ "$local_free_kb" =~ ^[0-9]+$ && $((local_free_kb * 1024)) -lt $need_b ]]; then
        warn "This Mac has $(human_gb $((local_free_kb * 1024))) free. The first backup is held on the Mac until it is"
        warn "uploaded, so on a slow connection it can temporarily need up to that much space."
    fi

    info "Installing the background service..."
    service_stop
    install_binaries
    write_plist
    touch "$LOG_FILE"
    service_start || die "Could not start the background service. See $LOG_FILE"
    wait_for 90 drive_mounted || die "Google Drive did not mount. See $LOG_FILE"
    ok "Google Drive is mounted"

    if [[ -d "$IMAGE" ]]; then
        info "Found an existing backup disk in the Google Drive folder \"$DRIVE_FOLDER\"."
        if [[ ! -f "$PASSWORD_FILE" ]]; then
            local pw tries=0
            while :; do
                if [[ -n "$TM2GDRIVE_DISK_PASSWORD" ]]; then
                    pw="$TM2GDRIVE_DISK_PASSWORD"
                else
                    printf 'Enter the backup disk password: '
                    read -rs pw || die "No password entered."
                    echo
                fi
                printf '%s' "$pw" > "$PASSWORD_FILE"
                wait_for 60 disk_attached && break
                tries=$((tries + 1))
                rm -f "$PASSWORD_FILE"
                [[ -n "$TM2GDRIVE_DISK_PASSWORD" || $tries -ge 3 ]] && die "That password didn't open the backup disk."
                warn "That password didn't open the backup disk. Try again."
            done
        fi
    else
        local pw="${TM2GDRIVE_DISK_PASSWORD:-}"
        if [[ -z "$pw" ]]; then
            pw=$(openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-32)
            [[ ${#pw} -ge 32 ]] || die "Could not generate a password."
        fi
        printf '%s' "$pw" > "$PASSWORD_FILE"
        info "Creating an encrypted ${DISK_SIZE_GB} GB backup disk in Google Drive (it only uses space as it fills)..."
        if ! printf '%s' "$pw" | hdiutil create -size "${DISK_SIZE_GB}g" -type SPARSEBUNDLE -fs APFS \
            -volname "$VOLUME_NAME" -encryption AES-256 -stdinpass \
            -imagekey sparse-band-size="$BAND_SECTORS" "$IMAGE" >/dev/null; then
            rm -rf "$IMAGE" "$PASSWORD_FILE"
            die "Could not create the backup disk. See $LOG_FILE"
        fi
        if [[ -z "$TM2GDRIVE_DISK_PASSWORD" ]]; then
            echo
            echo "${C_BLD}${C_YEL}IMPORTANT: your backup disk password${C_OFF}"
            echo
            echo "    ${C_BLD}$pw${C_OFF}"
            echo
            echo "Your backups are encrypted with it before they reach Google, and you need it"
            echo "to restore onto another Mac. Save it in your password manager now."
            echo
            while :; do
                confirm "I have saved the password somewhere outside this Mac." && break
                [[ $? -eq 2 ]] && die "No answer received. Run \"$PROG setup\" again in a terminal."
            done
        fi
    fi
    wait_for 120 volume_mounted || die "The backup disk did not attach. See $LOG_FILE"
    ok "Backup disk \"$VOLUME_NAME\" is attached"

    if [[ -n "$TM2GDRIVE_SKIP_TIME_MACHINE" ]]; then
        :
    elif [[ -n "$(tm_destination_id)" ]]; then
        ok "Time Machine already backs up to \"$VOLUME_NAME\""
    elif tmutil setdestination -a "$VOLUME" 2>/dev/null; then
        tmutil enable 2>/dev/null
        tmutil addexclusion -p "$CACHE_DIR" 2>/dev/null
        ok "Time Machine now backs up to \"$VOLUME_NAME\" every hour"
    else
        warn "macOS didn't let $PROG pick the backup disk for you. One click left:"
        echo "    In the Time Machine settings that just opened, click \"Add Backup Disk\" (or +),"
        echo "    choose \"$VOLUME_NAME\" and click \"Set Up Disk\". Leave \"Encrypt Backup\" off:"
        echo "    the disk is already encrypted."
        open "x-apple.systempreferences:com.apple.Time-Machine-Settings.extension" 2>/dev/null
    fi

    echo
    ok "Setup complete."
    echo "    Time Machine backs up to \"$VOLUME_NAME\" automatically. Use the Time Machine app as usual."
    echo "    See whether everything has reached Google Drive with: $PROG status"
    if [[ -z "$TM2GDRIVE_SKIP_TIME_MACHINE" && -n "$(tm_destination_id)" ]] \
        && confirm "Start the first backup now?"; then
        if tmutil startbackup --auto 2>/dev/null; then
            ok "First backup started."
        else
            info "Time Machine will start the first backup by itself within the hour."
        fi
    fi
    return 0
}

cmd_status() {
    [[ $# -eq 0 ]] || die "status takes no options."
    require_macos; require_root status; require_setup; load_config
    local problems=0 pending used free

    if service_loaded; then ok "Background service is running"; else err "Background service is not running (start it: $PROG start)"; problems=1; fi
    if drive_mounted; then ok "Google Drive folder \"$DRIVE_FOLDER\" is mounted"; else err "Google Drive is not mounted (see: $PROG logs)"; problems=1; fi
    if volume_mounted; then
        used=$(df -h "$VOLUME" | awk 'NR == 2 { print $3 " used of " $2 }')
        ok "Backup disk \"$VOLUME_NAME\" is attached ($used)"
    else
        err "Backup disk \"$VOLUME_NAME\" is not attached (see: $PROG logs)"; problems=1
    fi
    if [[ -n "$(tm_destination_id)" ]]; then
        ok "Time Machine backs up to it"
    else
        warn "Time Machine isn't using \"$VOLUME_NAME\" yet (System Settings > General > Time Machine)"
    fi
    tm_running && info "A Time Machine backup is running now"

    pending=$(pending_uploads)
    if [[ -z "$pending" ]]; then
        warn "Upload status unavailable"
    elif [[ "$pending" -eq 0 ]]; then
        ok "Everything is uploaded to Google Drive"
    else
        info "Uploading: $pending file(s) still on their way to Google Drive"
    fi
    free=$(drive_free_bytes)
    [[ -n "$free" ]] && info "Google Drive free space: $(human_gb "$free")"
    [[ $problems -eq 0 ]]
}

cmd_start() {
    require_macos; require_root start; require_setup
    service_start || die "Could not start the service."
    ok "Started."
}

cmd_stop() {
    require_macos; require_root stop
    service_stop
    ok "Stopped. The backup disk is detached; anything not yet uploaded is sent on the next start."
}

cmd_restart() {
    require_macos; require_root restart; require_setup
    service_stop
    service_start || die "Could not start the service."
    ok "Restarted."
}

cmd_logs() {
    [[ -f "$LOG_FILE" ]] || die "No log yet ($LOG_FILE)."
    if [[ "$1" == "-f" || "$1" == "--follow" ]]; then
        tail -n 50 -f "$LOG_FILE"
    else
        tail -n 50 "$LOG_FILE"
    fi
}

cmd_reconnect() {
    require_macos
    [[ $EUID -eq 0 && -n "$SUDO_USER" ]] && die "Run reconnect as your normal user, without sudo."
    sudo test -f "$RCLONE_CONF" || die "$PROG is not set up yet. Run: $PROG setup"
    local tmp
    tmp=$(mktemp -t tm2gdrive-rclone) || die "Could not create a temporary file."
    # shellcheck disable=SC2024  # the copy is meant to be owned by the user
    sudo cat "$RCLONE_CONF" > "$tmp" || { rm -f "$tmp"; die "Could not read the settings."; }
    info "A browser window will open. Sign in with the Google account that holds the backups."
    RCLONE_CONFIG="$tmp" rclone config reconnect "${RCLONE_REMOTE}:" || { rm -f "$tmp"; die "Reconnecting failed."; }
    sudo install -m 600 -o root -g wheel "$tmp" "$RCLONE_CONF"
    rm -f "$tmp"
    sudo /bin/bash "$0" restart
}

cmd_uninstall() {
    local purge=""
    case "$1" in
        "") ;;
        --purge) purge=1 ;;
        *) die "Unknown option for uninstall: $1" ;;
    esac
    require_macos; require_root uninstall
    load_config
    local id
    id=$(tm_destination_id)
    if [[ -n "$id" ]]; then
        tmutil removedestination "$id" 2>/dev/null && ok "Removed \"$VOLUME_NAME\" from Time Machine"
    fi
    service_stop
    rm -f "$PLIST"
    rm -rf "$BIN_DIR"
    ok "Background service removed"
    if [[ -n "$purge" ]]; then
        rm -rf "$STATE_DIR" "$CACHE_DIR"
        ok "Settings, the stored disk password and the cache are deleted from this Mac"
    else
        info "Settings and the disk password stay in \"$STATE_DIR\" (remove them with: $PROG uninstall --purge)"
    fi
    info "Your backups stay in the Google Drive folder \"$DRIVE_FOLDER\"."
}

usage() {
    cat <<EOF
$PROG $VERSION - use Google Drive as a Time Machine backup disk

Usage: $PROG <command>

  setup          Sign in to Google Drive and set everything up (run once)
  status         Is everything running, and has everything reached Google Drive?
  logs [-f]      Show the service log (-f to keep following it)
  reconnect      Sign in to Google again (if the sign-in expired)
  restart        Restart the background service (after editing settings)
  stop | start   Stop or start the background service
  uninstall      Remove the service and the Time Machine disk (your backups stay in Drive)
      --purge      Also delete the settings, the stored disk password and the cache
  version        Print the version

Settings: $CONFIG_FILE
Log:      $LOG_FILE
Docs:     https://github.com/nooranshdhaka/time-machine-to-google-drive
EOF
}

main() {
    local cmd="${1:-help}"
    [[ $# -gt 0 ]] && shift
    case "$cmd" in
        setup)        cmd_setup "$@" ;;
        _setup-root)  cmd_setup_root "$@" ;;
        reconnect)    cmd_reconnect "$@" ;;
        status|start|stop|restart|uninstall)
            ensure_root "$cmd" "$@"
            "cmd_$cmd" "$@" ;;
        logs)         cmd_logs "$@" ;;
        daemon)       cmd_daemon "$@" ;;
        version|--version|-v) echo "$PROG $VERSION" ;;
        help|--help|-h) usage ;;
        *) usage >&2; exit 1 ;;
    esac
}

[[ -n "$TM2GDRIVE_SOURCE_ONLY" ]] || main "$@"
