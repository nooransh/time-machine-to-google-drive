#!/bin/bash
#
# tm2gdrive - Time Machine backups to Google Drive, encrypted on the Mac.
#
# How it works (details in README.md):
#   * rclone mounts an encrypted ("crypt") Google Drive folder on the Mac with
#     FUSE-T, a FUSE implementation without kernel extensions.
#   * Samba shares that folder on 127.0.0.1 only, as a Time Machine network
#     disk. Time Machine backs up to it every hour, like to a NAS.
#   * Changed files are kept on the Mac until they are uploaded. When too much
#     is waiting, writes pause, so a first backup never fills the Mac's disk.
#   * Everything runs as you (a LaunchAgent), not as root. Setup only needs
#     administrator rights to install FUSE-T and to add the Time Machine disk.
#
# https://github.com/nooranshdhaka/time-machine-to-google-drive
#
# Written for the bash 3.2 that ships with macOS.

set -o pipefail

VERSION="3.0.0"
PROG="tm2gdrive"
LABEL="io.github.nooranshdhaka.tm2gdrive"
REPO="nooranshdhaka/time-machine-to-google-drive"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# ---------------------------------------------------------------------------
# Locations (the TM2GDRIVE_* overrides exist for the test suite)
# ---------------------------------------------------------------------------
STATE_DIR="${TM2GDRIVE_STATE_DIR:-$HOME/Library/Application Support/tm2gdrive}"
CACHE_DIR="${TM2GDRIVE_CACHE_DIR:-$HOME/Library/Caches/tm2gdrive}"
LOG_FILE="${TM2GDRIVE_LOG:-$HOME/Library/Logs/tm2gdrive.log}"
PLIST="${TM2GDRIVE_PLIST:-$HOME/Library/LaunchAgents/$LABEL.plist}"
CONFIG_FILE="$STATE_DIR/config"
RCLONE_CONF="$STATE_DIR/rclone.conf"
SMB_PASSWORD_FILE="$STATE_DIR/smb-password"
BIN_DIR="$STATE_DIR/bin"
RCLONE="${TM2GDRIVE_RCLONE:-$BIN_DIR/rclone}"
SAMBA_DIR="$STATE_DIR/samba"
SMB_CONF="$SAMBA_DIR/smb.conf"
DRIVE_MNT="${TM2GDRIVE_DRIVE_MNT:-$STATE_DIR/drive}"
RC_SOCKET="$STATE_DIR/rc.sock"
SHARE="tm2gdrive"           # Samba share name; Time Machine shows it as the disk name
SMB_USER="tm2gdrive"        # share login, mapped to the Mac user (see write_smb_conf)
DRIVE_REMOTE="gdrive"       # rclone remote for Google Drive (in $RCLONE_CONF)
CRYPT_REMOTE="tm2gdrive"    # rclone crypt remote on top of it

# rclone with tm2gdrive's patches (rclone/README.md), built by GitHub Actions
# from rclone's source. Setup downloads it and checks these checksums.
RCLONE_RELEASE="rclone-v1.75.2-tm2gdrive.1"
RCLONE_SHA256_ARM64="0c4dd0937420bbc5b87396cb7f84772df4048b57e7d809224eac48082f3536a0"
RCLONE_SHA256_AMD64="28217d98a5dfa36010f8a88c0917c2597896e8e06baa0eab804e45cad12bd228"

# ---------------------------------------------------------------------------
# Settings (override in $CONFIG_FILE)
# ---------------------------------------------------------------------------
SETTINGS="DRIVE_FOLDER BACKUP_SIZE_GB SMB_PORT CACHE_MAX_GB MAX_PENDING_GB CACHE_MIN_FREE_GB TRANSFERS BWLIMIT"
NUMERIC_SETTINGS="BACKUP_SIZE_GB SMB_PORT CACHE_MAX_GB MAX_PENDING_GB CACHE_MIN_FREE_GB TRANSFERS"
DRIVE_FOLDER="tm2gdrive-backups"   # Google Drive folder that holds the encrypted backups
BACKUP_SIZE_GB=0                   # size limit Time Machine sees; 0 = chosen at setup
SMB_PORT=44545                     # local port of the Time Machine share (127.0.0.1 only)
CACHE_MAX_GB=5                     # keep up to this much already-uploaded data on the Mac
MAX_PENDING_GB=5                   # pause backups while this much is waiting to upload
CACHE_MIN_FREE_GB=20               # keep at least this much free space on the Mac
TRANSFERS=4                        # parallel uploads
BWLIMIT=""                         # optional bandwidth limit, e.g. "20M" (rclone --bwlimit)

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_BLU=$'\033[34m'; C_BLD=$'\033[1m'; C_OFF=$'\033[0m'
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BLU=""; C_BLD=""; C_OFF=""
fi
info() { printf '%s==>%s %s\n' "$C_BLU" "$C_OFF" "$*"; }
ok()   { printf '%s✔%s %s\n' "$C_GRN" "$C_OFF" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; }
err()  { printf '%s✘ %s%s\n' "$C_RED" "$*" "$C_OFF" >&2; }
die()  { err "$*"; exit 1; }
log()  { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }   # service: stdout is the log file

# Returns 0 for yes, 1 for no, 2 if there is no input at all.
confirm() {
    local reply
    [[ -n "$TM2GDRIVE_ASSUME_YES" ]] && return 0
    printf '%s [y/N] ' "$1"
    read -r reply || return 2
    [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]]
}

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

# Reads KEY=value lines. The file is parsed, never executed.
read_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    local line key val
    local re_skip='^[[:space:]]*(#.*)?$' re_kv='^[[:space:]]*([A-Z_]+)[[:space:]]*=(.*)$'
    local re_dq='^"([^"]*)"' re_sq="^'([^']*)'"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ $re_skip ]] && continue
        if [[ ! "$line" =~ $re_kv ]]; then
            warn "Ignoring unreadable line in $CONFIG_FILE: $line"
            continue
        fi
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        val="${val#"${val%%[![:space:]]*}"}"
        if [[ "$val" =~ $re_dq || "$val" =~ $re_sq ]]; then
            val="${BASH_REMATCH[1]}"
        else
            val="${val%%#*}"
            val="${val%"${val##*[![:space:]]}"}"
        fi
        case " $SETTINGS " in
            *" $key "*) eval "$key=\$val" ;;
            *) warn "Unknown setting in $CONFIG_FILE: $key" ;;
        esac
    done < "$CONFIG_FILE"
}

load_config() {
    read_config
    local key
    for key in $NUMERIC_SETTINGS; do
        [[ "${!key}" =~ ^[0-9]+$ ]] || die "$key in $CONFIG_FILE must be a whole number."
    done
    [[ $SMB_PORT -ge 1024 && $SMB_PORT -le 65535 ]] || die "SMB_PORT in $CONFIG_FILE must be between 1024 and 65535."
    [[ $TRANSFERS -ge 1 ]] || die "TRANSFERS in $CONFIG_FILE must be at least 1."
    [[ -n "$DRIVE_FOLDER" && "$DRIVE_FOLDER" != /* && "$DRIVE_FOLDER" != *..* ]] \
        || die "DRIVE_FOLDER in $CONFIG_FILE is not a valid folder name."
    [[ "$BWLIMIT" =~ ^[0-9A-Za-z.:,\ -]*$ ]] || die "BWLIMIT in $CONFIG_FILE is not a valid rclone --bwlimit value."
}

write_config() {
    cat > "$CONFIG_FILE" <<EOF
# tm2gdrive settings. See "Settings" in README.md.
# After editing, restart the service: $PROG restart
DRIVE_FOLDER="$DRIVE_FOLDER"
BACKUP_SIZE_GB=$BACKUP_SIZE_GB
SMB_PORT=$SMB_PORT
CACHE_MAX_GB=$CACHE_MAX_GB
MAX_PENDING_GB=$MAX_PENDING_GB
CACHE_MIN_FREE_GB=$CACHE_MIN_FREE_GB
TRANSFERS=$TRANSFERS
BWLIMIT="$BWLIMIT"
EOF
    chmod 600 "$CONFIG_FILE"
}

# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------
require_macos() {
    [[ "$(uname -s)" == "Darwin" ]] || die "$PROG runs on macOS."
}

require_user() {
    [[ $EUID -ne 0 ]] || die "Run $PROG as your normal user, without sudo. It asks for your password when it needs it."
}

require_setup() {
    [[ -f "$CONFIG_FILE" && -f "$RCLONE_CONF" ]] || die "$PROG is not set up yet. Run: $PROG setup"
}

# Homebrew's Samba (the smbd binary is renamed to avoid clashing with macOS's).
samba_prefix() {
    local p
    for p in "${TM2GDRIVE_SAMBA_PREFIX:-}" /opt/homebrew/opt/samba /usr/local/opt/samba; do
        [[ -n "$p" && -x "$p/sbin/samba-dot-org-smbd" ]] && { echo "$p"; return 0; }
    done
    return 1
}

fuse_t_installed() { [[ -n "$TM2GDRIVE_SKIP_FUSE_T" || -d /Library/Frameworks/fuse_t.framework ]]; }

# tm2gdrive needs rclone with its patches (rclone/README.md).
rclone_patched() {
    local help
    [[ -x "$RCLONE" ]] && help=$("$RCLONE" mount --help 2>/dev/null) && [[ "$help" == *--vfs-cache-max-pending* ]]
}

# Adding a Time Machine disk from the command line needs Full Disk Access for
# the terminal app (macOS privacy protection, which applies even to root).
# This is a best guess (macOS has no API for it): it tries folders that only
# apps with Full Disk Access can list. Unknown counts as yes; tmutil decides.
has_full_disk_access() {
    [[ -n "$TM2GDRIVE_SKIP_FDA_CHECK" ]] && return 0
    local dir tried=""
    for dir in "$HOME/Library/Safari" "$HOME/Library/Mail" "$HOME/Library/Application Support/com.apple.TCC"; do
        [[ -e "$dir" ]] || continue
        tried=1
        ls "$dir" >/dev/null 2>&1 && return 0
    done
    [[ -z "$tried" ]]
}

FDA_HELP="Open System Settings > Privacy & Security > Full Disk Access and turn it on for
    your terminal app (Terminal or iTerm). Then quit the terminal (Cmd-Q), open it
    again and run: $PROG setup"

# ---------------------------------------------------------------------------
# State helpers
# ---------------------------------------------------------------------------
# Output is captured before matching: with pipefail, "cmd | grep -q" can report
# a failure when grep stops reading early.
drive_mounted()  { [[ "$(mount)" == *" on $DRIVE_MNT ("* ]]; }
smb_listening()  { nc -z -G 2 127.0.0.1 "$SMB_PORT" >/dev/null 2>&1; }
tm_running()     { [[ "$(tmutil status 2>/dev/null)" == *"Running = 1"* ]]; }
agent_loaded()   { launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; }

rc() {
    "$RCLONE" rc --unix-socket "$RC_SOCKET" "$@" 2>/dev/null
}

json_number() {   # json_number <key> : reads JSON on stdin
    grep -oE "\"$1\":[[:space:]]*[0-9]+" | head -1 | grep -oE '[0-9]+$'
}

# "<files> <bytes> <open files>" not yet uploaded to Google Drive; empty if
# unknown. Files still open (being written) upload once they are closed.
pending_uploads() {
    local stats files bytes dirty
    stats=$(rc vfs/stats) || return 0
    files=$(printf '%s' "$stats" | json_number pendingFiles)
    bytes=$(printf '%s' "$stats" | json_number pendingBytes)
    dirty=$(printf '%s' "$stats" | json_number dirtyFiles)
    [[ -n "$files" && -n "$bytes" && -n "$dirty" ]] && echo "$files $bytes $((dirty - files))"
}

drive_free_bytes() {
    "$RCLONE" --config "$RCLONE_CONF" about "${DRIVE_REMOTE}:" --json 2>/dev/null | json_number free
}

human_gb() { awk -v b="$1" 'BEGIN { printf "%.1f GB", b / 1000000000 }'; }

# Time Machine destination ID for our share.
tm_destination_id() {
    tmutil destinationinfo 2>/dev/null | awk -v s="$SHARE" '
        function check() { if (name == s && kind == "Network" && id != "") { print id; return 1 } return 0 }
        /^====/ { if (check()) { done = 1; exit } name = ""; kind = ""; id = ""; next }
        /^Name/ { sub(/^Name[[:space:]]*:[[:space:]]*/, ""); name = $0 }
        /^Kind/ { sub(/^Kind[[:space:]]*:[[:space:]]*/, ""); kind = $0 }
        /^ID/   { sub(/^ID[[:space:]]*:[[:space:]]*/, ""); id = $0 }
        END { if (!done) check() }'
}

wait_for() {   # wait_for <seconds> <command...>
    local t="$1" _
    shift
    for _ in $(seq 1 "$t"); do
        "$@" && return 0
        sleep 1
    done
    return 1
}

# Size limit Time Machine sees. Time Machine picks its band size (the unit it
# uploads) from it: about limit / 3800, so 1.5x the Mac's data gives about
# 100 MB bands for a 250 GB Mac while leaving room for history.
choose_backup_size() {
    local free="$1" need_b="$2" size cap
    size=$(( need_b * 3 / 2 / 1000000000 ))
    [[ $size -lt 100 ]] && size=100
    if [[ -n "$free" ]]; then
        cap=$(( free * 9 / 10 / 1000000000 ))
        [[ $size -gt $cap ]] && size=$cap
    fi
    echo "$size"
}

# ---------------------------------------------------------------------------
# The background service (a LaunchAgent: runs as the user)
# ---------------------------------------------------------------------------
RCLONE_PID=""
SMBD_PID=""

write_smb_conf() {
    local s="$SAMBA_DIR"
    mkdir -p "$s/lock" "$s/state" "$s/cache" "$s/private" "$s/pid"
    # Time Machine only works with Samba's "fruit" module. Mac metadata goes
    # into extended attributes, which the macOS kernel keeps in "._" files on
    # the rclone mount; there is no stream module because streams_xattr and
    # streams_depot both break on it. Samba runs as the user, so it can only
    # ever act as the user.
    # Time Machine logs in as "tm2gdrive", mapped to the Mac user: with the Mac
    # user's own name, macOS first tries local Kerberos and times out.
    echo "$(id -un) = $SMB_USER" > "$s/usermap"
    cat > "$SMB_CONF" <<EOF
# Written by $PROG at every start; edit $CONFIG_FILE instead.
[global]
  server role = standalone server
  interfaces = 127.0.0.1
  bind interfaces only = yes
  smb ports = $SMB_PORT
  disable netbios = yes
  map to guest = never
  username map = $s/usermap
  server min protocol = SMB3
  passdb backend = tdbsam:$s/private/passdb.tdb
  lock directory = $s/lock
  state directory = $s/state
  cache directory = $s/cache
  private dir = $s/private
  pid directory = $s/pid
  ncalrpc dir = $s/state/ncalrpc
  log file = $s/samba.log
  max log size = 1000
  log level = 1
  vfs objects = catia fruit
  fruit:metadata = netatalk
  fruit:resource = xattr
  fruit:model = MacSamba
  fruit:posix_rename = yes
  fruit:zero_file_id = yes
  nt acl support = no
  create mask = 0600
  directory mask = 0700
  vfs mkdir use tmp name = no
[$SHARE]
  path = $DRIVE_MNT
  valid users = $(id -un)
  read only = no
  fruit:time machine = yes
  fruit:time machine max size = ${BACKUP_SIZE_GB}G
EOF
    chmod 600 "$SMB_CONF"
}

start_rclone() {
    local args=(
        mount "${CRYPT_REMOTE}:" "$DRIVE_MNT"
        --config "$RCLONE_CONF"
        --cache-dir "$CACHE_DIR"
        --vfs-cache-mode full
        --vfs-write-back 10s
        --vfs-cache-max-size "${CACHE_MAX_GB}G"
        --vfs-cache-max-pending "${MAX_PENDING_GB}G"
        --vfs-cache-min-free-space "${CACHE_MIN_FREE_GB}G"
        --vfs-cache-max-age 8760h
        --dir-cache-time 8760h
        --transfers "$TRANSFERS"
        --drive-chunk-size 64M
        --drive-use-trash=false
        --noappledouble=false
        -o hard_remove
        --volname "tm2gdrive"
        --rc --rc-addr "unix://$RC_SOCKET" --rc-no-auth
        --log-level "${TM2GDRIVE_LOG_LEVEL:-NOTICE}"
    )
    [[ -n "$BWLIMIT" ]] && args+=(--bwlimit "$BWLIMIT")
    mkdir -p "$DRIVE_MNT" "$CACHE_DIR"
    rm -f "$RC_SOCKET"
    "$RCLONE" "${args[@]}" &
    RCLONE_PID=$!
    log "started rclone (pid $RCLONE_PID) for Google Drive folder \"$DRIVE_FOLDER\""
    local _
    for _ in $(seq 1 60); do
        drive_mounted && { log "mounted the encrypted Drive folder"; return 0; }
        kill -0 "$RCLONE_PID" 2>/dev/null || { log "rclone exited during startup"; RCLONE_PID=""; return 1; }
        sleep 1
    done
    log "the Drive folder did not mount"
    return 1
}

start_samba() {
    local prefix
    prefix=$(samba_prefix) || { log "Samba is not installed (brew install samba)"; return 1; }
    write_smb_conf
    "$prefix/sbin/samba-dot-org-smbd" --foreground --no-process-group -s "$SMB_CONF" \
        --log-basename="$SAMBA_DIR" </dev/null &
    SMBD_PID=$!
    if wait_for 30 smb_listening; then
        log "Time Machine share is listening on 127.0.0.1:$SMB_PORT (pid $SMBD_PID)"
        return 0
    fi
    log "Samba did not start (see $SAMBA_DIR/samba.log)"
    stop_pid "$SMBD_PID"; SMBD_PID=""
    return 1
}

stop_pid() {   # TERM, then KILL after 30 seconds
    [[ -n "$1" ]] && kill -0 "$1" 2>/dev/null || return 0
    kill -TERM "$1" 2>/dev/null
    # shellcheck disable=SC2016  # evaluated later by wait_for
    wait_for 30 eval '! kill -0 "$1" 2>/dev/null' || kill -KILL "$1" 2>/dev/null
}

unmount_drive() {
    drive_mounted || return 0
    umount "$DRIVE_MNT" 2>/dev/null || diskutil unmount force "$DRIVE_MNT" >/dev/null 2>&1
}

stop_everything() {
    log "stopping"
    # Samba first, so nothing writes to the Drive folder while it unmounts.
    stop_pid "$SMBD_PID"; SMBD_PID=""
    unmount_drive
    stop_pid "$RCLONE_PID"; RCLONE_PID=""
    log "stopped (files not yet uploaded are kept and uploaded on the next start)"
}

# Processes left behind by a crashed service would hold the port or the mount.
kill_leftovers() {
    local pids
    pids=$(pgrep -f "samba-dot-org-smbd .*-s $SMB_CONF" 2>/dev/null)
    # shellcheck disable=SC2086  # one or more pids
    [[ -n "$pids" ]] && { log "stopping leftover Samba (pid $pids)"; kill -TERM $pids 2>/dev/null; sleep 2; }
    unmount_drive
    pids=$(pgrep -f "rclone mount ${CRYPT_REMOTE}: $DRIVE_MNT" 2>/dev/null)
    # shellcheck disable=SC2086
    [[ -n "$pids" ]] && { log "stopping leftover rclone (pid $pids)"; kill -TERM $pids 2>/dev/null; sleep 2; }
    return 0
}

cmd_daemon() {
    require_user; require_setup; load_config
    trap 'stop_everything; exit 0' TERM INT HUP
    log "$PROG $VERSION service starting"
    rclone_patched || { log "$RCLONE is missing or lacks tm2gdrive's patches; run $PROG setup"; sleep 60; exit 1; }
    kill_leftovers

    while :; do
        if [[ -z "$RCLONE_PID" ]] || ! kill -0 "$RCLONE_PID" 2>/dev/null || ! drive_mounted; then
            [[ -n "$RCLONE_PID" ]] && log "rclone stopped unexpectedly; restarting"
            # Samba must not serve the empty mount point.
            stop_pid "$SMBD_PID"; SMBD_PID=""
            stop_pid "$RCLONE_PID"; RCLONE_PID=""
            unmount_drive
            start_rclone || { sleep 10 & wait $!; continue; }
        fi
        if [[ -z "$SMBD_PID" ]] || ! kill -0 "$SMBD_PID" 2>/dev/null; then
            [[ -n "$SMBD_PID" ]] && log "Samba stopped unexpectedly; restarting"
            start_samba || { sleep 10 & wait $!; continue; }
        fi
        sleep 10 & wait $!
    done
}

# ---------------------------------------------------------------------------
# Service management
# ---------------------------------------------------------------------------
write_plist() {
    local extra_env="" v
    for v in TM2GDRIVE_STATE_DIR TM2GDRIVE_CACHE_DIR TM2GDRIVE_DRIVE_MNT TM2GDRIVE_LOG TM2GDRIVE_PLIST \
             TM2GDRIVE_RCLONE TM2GDRIVE_SAMBA_PREFIX TM2GDRIVE_LOG_LEVEL; do
        [[ -n "${!v:-}" ]] && extra_env="$extra_env
        <key>$v</key><string>${!v}</string>"
    done
    mkdir -p "$(dirname "$PLIST")"
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$BIN_DIR/tm2gdrive</string>
        <string>daemon</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>$extra_env
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ExitTimeOut</key>
    <integer>90</integer>
    <key>StandardOutPath</key>
    <string>$LOG_FILE</string>
    <key>StandardErrorPath</key>
    <string>$LOG_FILE</string>
</dict>
</plist>
EOF
    chmod 644 "$PLIST"
}

install_self() {
    local self
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    mkdir -p "$BIN_DIR"
    [[ "$self" == "$BIN_DIR/tm2gdrive" ]] && return 0
    if ! { install -m 755 "$self" "$BIN_DIR/tm2gdrive.new" && mv -f "$BIN_DIR/tm2gdrive.new" "$BIN_DIR/tm2gdrive"; }; then
        die "Could not install the service."
    fi
}

agent_start() {
    agent_loaded && return 0
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl load -w "$PLIST"
}

agent_stop() {
    agent_loaded || return 0
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || launchctl unload "$PLIST" 2>/dev/null
    wait_for 100 eval '! agent_loaded'
}

# ---------------------------------------------------------------------------
# Setup steps
# ---------------------------------------------------------------------------
install_fuse_t() {
    fuse_t_installed && { ok "FUSE-T is installed"; return 0; }
    info "Installing FUSE-T (lets rclone show Google Drive as a folder, without kernel extensions)."
    info "Homebrew will ask for your password."
    brew install --cask macos-fuse-t/cask/fuse-t || die "Could not install FUSE-T."
    fuse_t_installed || die "FUSE-T did not install."
    ok "FUSE-T is installed"
}

install_samba() {
    samba_prefix >/dev/null && { ok "Samba is installed"; return 0; }
    info "Installing Samba (serves the backup folder to Time Machine, on this Mac only)..."
    brew install samba || die "Could not install Samba."
    samba_prefix >/dev/null || die "Samba did not install."
    ok "Samba is installed"
}

install_rclone() {
    if [[ -n "$TM2GDRIVE_RCLONE" ]]; then
        rclone_patched || die "$TM2GDRIVE_RCLONE is not rclone with tm2gdrive's patches."
        return 0
    fi
    local arch sum zip tmp got
    case "$(uname -m)" in
        arm64)  arch=arm64; sum="$RCLONE_SHA256_ARM64" ;;
        x86_64) arch=amd64; sum="$RCLONE_SHA256_AMD64" ;;
        *) die "Unsupported Mac: $(uname -m)" ;;
    esac
    if rclone_patched && [[ "$(cat "$BIN_DIR/rclone.release" 2>/dev/null)" == "$RCLONE_RELEASE" ]]; then
        ok "rclone is installed ($RCLONE_RELEASE)"
        return 0
    fi
    info "Downloading rclone with tm2gdrive's patches ($RCLONE_RELEASE)..."
    zip="rclone-darwin-$arch.zip"
    tmp=$(mktemp -d -t tm2gdrive) || die "Could not create a temporary folder."
    curl -fsSL --retry 3 -o "$tmp/$zip" "https://github.com/$REPO/releases/download/$RCLONE_RELEASE/$zip" \
        || { rm -rf "$tmp"; die "Could not download rclone."; }
    got=$(shasum -a 256 "$tmp/$zip" | cut -d' ' -f1)
    [[ "$got" == "$sum" ]] || { rm -rf "$tmp"; die "The rclone download is damaged or was tampered with (checksum $got)."; }
    if ! { unzip -q -o "$tmp/$zip" -d "$tmp" && [[ -f "$tmp/rclone" ]]; }; then
        rm -rf "$tmp"; die "Could not unpack rclone."
    fi
    mkdir -p "$BIN_DIR"
    install -m 755 "$tmp/rclone" "$BIN_DIR/rclone" || { rm -rf "$tmp"; die "Could not install rclone."; }
    rm -rf "$tmp"
    echo "$RCLONE_RELEASE" > "$BIN_DIR/rclone.release"
    rclone_patched || die "The downloaded rclone doesn't work."
    ok "rclone is installed ($RCLONE_RELEASE)"
}

has_remote() {   # has_remote <name>
    local remotes
    remotes=$("$RCLONE" --config "$RCLONE_CONF" listremotes 2>/dev/null)
    [[ $'\n'"$remotes"$'\n' == *$'\n'"$1:"$'\n'* ]]
}

sign_in() {   # sign_in <client id> <client secret>
    local client_id="$1" client_secret="$2"
    if has_remote "$DRIVE_REMOTE"; then
        ok "Already signed in to Google Drive"
        return 0
    fi
    if [[ -n "$TM2GDRIVE_DRIVE_REMOTE_CONF" ]]; then
        # Tests: a ready-made [gdrive] remote (e.g. a local folder).
        cat "$TM2GDRIVE_DRIVE_REMOTE_CONF" >> "$RCLONE_CONF"
        return 0
    fi
    echo
    echo "${C_BLD}Sign in to Google Drive${C_OFF}"
    echo "Use the client ID and secret you created (README.md, step 2)."
    [[ -n "$client_id" ]] || { printf 'Client ID: '; read -r client_id; }
    [[ -n "$client_secret" ]] || { printf 'Client secret: '; read -r client_secret; }
    [[ -n "$client_id" && -n "$client_secret" ]] || die "Client ID and secret are required."
    info "A browser window will open. Sign in with the Google account that should hold the backups."
    info "If Google says it hasn't verified the app, click Advanced, then Go to tm2gdrive (it's your own app)."
    "$RCLONE" --config "$RCLONE_CONF" config create "$DRIVE_REMOTE" drive \
        client_id="$client_id" client_secret="$client_secret" scope=drive.file >/dev/null \
        || die "Signing in to Google Drive failed."
    "$RCLONE" --config "$RCLONE_CONF" lsd "${DRIVE_REMOTE}:" >/dev/null 2>&1 \
        || die "Signed in, but Google Drive can't be reached."
    ok "Signed in to Google Drive"
}

# The backup password encrypts file contents and names (rclone crypt). The
# salt is derived from it, so the password alone restores the backups.
write_crypt_remote() {
    "$RCLONE" --config "$RCLONE_CONF" config create "$CRYPT_REMOTE" crypt \
        remote="${DRIVE_REMOTE}:$DRIVE_FOLDER" password="$1" password2="tm2gdrive-salt:$1" --obscure \
        >/dev/null || die "Could not save the encryption settings."
}

backup_password() {
    local obscured
    obscured=$("$RCLONE" --config "$RCLONE_CONF" config show "$CRYPT_REMOTE" 2>/dev/null \
        | awk -F' = ' '$1 == "password" { print $2 }')
    [[ -n "$obscured" ]] && "$RCLONE" reveal "$obscured" 2>/dev/null
}

# 0: the folder has files, 1: it is empty or missing, 2: Drive can't be listed.
drive_folder_has_backups() {
    local out
    if out=$("$RCLONE" --config "$RCLONE_CONF" lsf --max-depth 1 "${DRIVE_REMOTE}:$DRIVE_FOLDER" 2>&1); then
        [[ -n "$out" ]] && return 0
        return 1
    fi
    [[ "$out" == *"directory not found"* ]] && return 1
    return 2
}

# Does the crypt remote decrypt the existing folder? With a wrong password
# rclone skips every name (with a notice on stderr), so nothing is listed.
crypt_password_ok() {
    local out
    out=$("$RCLONE" --config "$RCLONE_CONF" lsf --max-depth 1 "${CRYPT_REMOTE}:" 2>/dev/null) || return 1
    [[ -n "$out" ]]
}

set_up_encryption() {
    if has_remote "$CRYPT_REMOTE"; then
        ok "Encryption is set up"
        return 0
    fi
    local pw tries=0 found
    drive_folder_has_backups
    found=$?
    if [[ $found -eq 0 ]]; then
        info "Found existing backups in the Google Drive folder \"$DRIVE_FOLDER\"."
        while :; do
            if [[ -n "$TM2GDRIVE_BACKUP_PASSWORD" ]]; then
                pw="$TM2GDRIVE_BACKUP_PASSWORD"
            else
                printf 'Enter their backup password: '
                read -rs pw || die "No password entered."
                echo
            fi
            write_crypt_remote "$pw"
            crypt_password_ok && break
            "$RCLONE" --config "$RCLONE_CONF" config delete "$CRYPT_REMOTE" >/dev/null 2>&1
            tries=$((tries + 1))
            [[ -n "$TM2GDRIVE_BACKUP_PASSWORD" || $tries -ge 3 ]] && die "That password doesn't decrypt the backups."
            warn "That password doesn't decrypt the backups. Try again."
        done
        ok "Backup password accepted"
        return 0
    fi
    [[ $found -eq 1 ]] || die "Can't read the Google Drive folder \"$DRIVE_FOLDER\". Check your connection and run setup again."

    pw="${TM2GDRIVE_BACKUP_PASSWORD:-}"
    if [[ -z "$pw" ]]; then
        pw=$(openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-32)
        [[ ${#pw} -ge 32 ]] || die "Could not generate a password."
    fi
    write_crypt_remote "$pw"
    "$RCLONE" --config "$RCLONE_CONF" mkdir "${CRYPT_REMOTE}:" || die "Could not create the Google Drive folder."
    [[ -n "$TM2GDRIVE_BACKUP_PASSWORD" ]] && return 0
    echo
    echo "${C_BLD}${C_YEL}IMPORTANT: your backup password${C_OFF}"
    echo
    echo "    ${C_BLD}$pw${C_OFF}"
    echo
    echo "Your backups are encrypted with it before they reach Google, and you need it"
    echo "to restore onto another Mac. Save it in your password manager now."
    echo "(Show it again on this Mac with: $PROG password)"
    echo
    while :; do
        confirm "I have saved the password somewhere outside this Mac." && break
        [[ $? -eq 2 ]] && die "No answer received. Run \"$PROG setup\" again in a terminal."
    done
}

set_up_samba_account() {
    local prefix pw
    prefix=$(samba_prefix) || die "Samba is not installed."
    write_smb_conf
    if [[ ! -s "$SMB_PASSWORD_FILE" ]]; then
        pw=$(openssl rand -hex 16) || die "Could not generate a password."
        printf '%s' "$pw" > "$SMB_PASSWORD_FILE"
        chmod 600 "$SMB_PASSWORD_FILE"
    fi
    pw=$(cat "$SMB_PASSWORD_FILE")
    # pdbedit, unlike smbpasswd -a, works without root.
    "$prefix/bin/pdbedit" -s "$SMB_CONF" -x -u "$(id -un)" >/dev/null 2>&1
    printf '%s\n%s\n' "$pw" "$pw" | "$prefix/bin/pdbedit" -s "$SMB_CONF" -a -u "$(id -un)" -t >/dev/null 2>&1 \
        || die "Could not create the Samba account."
}

add_time_machine_destination() {
    if [[ -n "$(tm_destination_id)" ]]; then
        ok "Time Machine already backs up to \"$SHARE\""
        return 0
    fi
    has_full_disk_access || {
        warn "Your terminal app may not have Full Disk Access. Time Machine needs it to accept the backup disk."
        echo "    $FDA_HELP"
    }
    local pw tm_err
    pw=$(cat "$SMB_PASSWORD_FILE")
    info "Adding the backup disk to Time Machine (macOS asks for your password)..."
    if tm_err=$(sudo tmutil setdestination -a "smb://$SMB_USER:$pw@127.0.0.1:$SMB_PORT/$SHARE" 2>&1); then
        sudo tmutil enable 2>/dev/null
        ok "Time Machine now backs up to \"$SHARE\" every hour"
        return 0
    fi
    err "Time Machine did not accept the backup disk: ${tm_err//$pw/***}"
    echo "    Everything else is ready. The usual cause is missing Full Disk Access:"
    echo "    $FDA_HELP"
    echo "    If it is on and this keeps happening, please report the message at"
    echo "    https://github.com/$REPO/issues"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" 2>/dev/null
    exit 1
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_setup() {
    local client_id="" client_secret=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --client-id)     client_id="$2"; shift ;;
            --client-secret) client_secret="$2"; shift ;;
            *) die "Unknown option for setup: $1" ;;
        esac
        shift
    done
    require_macos; require_user
    echo "${C_BLD}$PROG setup${C_OFF}: Time Machine backups to Google Drive"
    echo
    command -v brew >/dev/null 2>&1 || die "Install Homebrew (https://brew.sh), then run this again."
    umask 077
    mkdir -p "$STATE_DIR" "$CACHE_DIR" "$(dirname "$LOG_FILE")"
    chmod 700 "$STATE_DIR"
    load_config

    install_fuse_t
    install_samba
    install_rclone
    sign_in "$client_id" "$client_secret"
    set_up_encryption

    local free used_kb need_b
    free=$(drive_free_bytes)
    used_kb=$(df -k /System/Volumes/Data 2>/dev/null | awk 'NR == 2 { print $3 }')
    [[ "$used_kb" =~ ^[0-9]+$ ]] || used_kb=$(df -k / | awk 'NR == 2 { print $3 }')
    need_b=$((used_kb * 1024))
    [[ -n "$free" ]] && info "Google Drive has $(human_gb "$free") free. This Mac holds $(human_gb "$need_b") of data."
    [[ $BACKUP_SIZE_GB -eq 0 ]] && BACKUP_SIZE_GB=$(choose_backup_size "$free" "$need_b")
    [[ $BACKUP_SIZE_GB -ge 1 ]] || die "Not enough free space in Google Drive."
    if [[ $((BACKUP_SIZE_GB * 1000000000)) -lt $need_b ]]; then
        warn "Google Drive has less free space than this Mac's data; the first backup may not fit."
    fi
    write_config
    set_up_samba_account

    info "Starting the background service..."
    agent_stop
    install_self
    write_plist
    touch "$LOG_FILE"
    agent_start || die "Could not start the background service. See $LOG_FILE"
    wait_for 90 smb_listening || die "The backup share did not start. See: $PROG logs"
    ok "Encrypted Google Drive folder \"$DRIVE_FOLDER\" is ready (Time Machine limit: ${BACKUP_SIZE_GB} GB)"

    [[ -n "$TM2GDRIVE_SKIP_TIME_MACHINE" ]] || add_time_machine_destination

    echo
    ok "Setup complete."
    echo "    Time Machine backs up to \"$SHARE\" every hour. Use the Time Machine app as usual."
    echo "    The first backup uploads everything and can take a day or more; it carries on"
    echo "    after sleep and restarts. Check progress with: $PROG status"
    local id=""
    [[ -z "$TM2GDRIVE_SKIP_TIME_MACHINE" ]] && id=$(tm_destination_id)
    if [[ -n "$id" ]] && confirm "Start the first backup now?"; then
        if tmutil startbackup --destination "$id" 2>/dev/null; then
            ok "First backup started."
        else
            info "Time Machine will start the first backup by itself within the hour."
        fi
    fi
    return 0
}

cmd_status() {
    [[ $# -eq 0 ]] || die "status takes no options."
    require_macos; require_user; require_setup; load_config
    local problems=0 pending free

    if agent_loaded; then ok "Background service is running"; else err "Background service is not running (start it: $PROG start)"; problems=1; fi
    if drive_mounted; then ok "Encrypted Google Drive folder \"$DRIVE_FOLDER\" is mounted"; else err "Google Drive is not mounted (see: $PROG logs)"; problems=1; fi
    if smb_listening; then ok "Time Machine share is up (127.0.0.1:$SMB_PORT)"; else err "Time Machine share is down (see: $PROG logs)"; problems=1; fi
    if [[ -n "$(tm_destination_id)" ]]; then
        ok "Time Machine backs up to \"$SHARE\""
    else
        warn "Time Machine isn't using \"$SHARE\" (run: $PROG setup)"
    fi
    tm_running && info "A Time Machine backup is running now"

    pending=$(pending_uploads)
    if [[ -z "$pending" ]]; then
        warn "Upload status unavailable"
    else
        local files bytes open
        read -r files bytes open <<<"$pending"
        if [[ $files -eq 0 ]]; then
            ok "Everything is uploaded to Google Drive"
        else
            info "Uploading: $files file(s), $(human_gb "$bytes"), still on their way to Google Drive"
        fi
        [[ $open -gt 0 ]] && info "$open file(s) are still open; they upload once they are closed"
    fi
    free=$(drive_free_bytes)
    [[ -n "$free" ]] && info "Google Drive free space: $(human_gb "$free")"
    [[ $problems -eq 0 ]]
}

cmd_start() {
    require_macos; require_user; require_setup
    agent_start || die "Could not start the service."
    ok "Started."
}

cmd_stop() {
    require_macos; require_user
    agent_stop
    ok "Stopped. Anything not yet uploaded is sent on the next start."
}

cmd_restart() {
    require_macos; require_user; require_setup
    agent_stop
    agent_start || die "Could not start the service."
    ok "Restarted."
}

cmd_logs() {
    [[ -f "$LOG_FILE" ]] || die "No log yet ($LOG_FILE)."
    if [[ "$1" == "-f" || "$1" == "--follow" ]]; then
        tail -n 50 -f "$LOG_FILE"
    else
        tail -n 50 "$LOG_FILE"
    fi
}

cmd_reconnect() {
    require_macos; require_user; require_setup
    info "A browser window will open. Sign in with the Google account that holds the backups."
    "$RCLONE" --config "$RCLONE_CONF" config reconnect "${DRIVE_REMOTE}:" || die "Reconnecting failed."
    cmd_restart
}

cmd_password() {
    require_macos; require_user; require_setup
    local pw
    pw=$(backup_password)
    [[ -n "$pw" ]] || die "Could not read the backup password."
    echo "$pw"
}

cmd_uninstall() {
    local purge=""
    case "$1" in
        "") ;;
        --purge) purge=1 ;;
        *) die "Unknown option for uninstall: $1" ;;
    esac
    require_macos; require_user
    load_config
    if [[ -n "$purge" && -f "$RCLONE_CONF" ]]; then
        echo "--purge deletes the Google sign-in and the backup password from this Mac."
        confirm "Have you saved the backup password elsewhere? (show it with: $PROG password)" \
            || die "Nothing was removed. Save the password, then run uninstall --purge again."
    fi
    local id
    id=$(tm_destination_id)
    if [[ -n "$id" ]]; then
        info "Removing \"$SHARE\" from Time Machine (macOS asks for your password)..."
        sudo tmutil removedestination "$id" 2>/dev/null && ok "Removed \"$SHARE\" from Time Machine"
    fi
    agent_stop
    rm -f "$PLIST"
    rm -rf "$BIN_DIR"
    ok "Background service removed"
    if [[ -n "$purge" ]]; then
        rm -rf "$STATE_DIR" "$CACHE_DIR"
        ok "Settings, the backup password and the cache are deleted from this Mac"
    else
        info "Settings and the backup password stay in \"$STATE_DIR\" (remove them with: $PROG uninstall --purge)"
    fi
    info "Your backups stay in the Google Drive folder \"$DRIVE_FOLDER\"."
    info "FUSE-T and Samba stay installed (brew uninstall --cask fuse-t; brew uninstall samba)."
}

usage() {
    cat <<EOF
$PROG $VERSION - Time Machine backups to Google Drive, encrypted on your Mac

Usage: $PROG <command>

  setup          Install, sign in to Google Drive and add the Time Machine disk (run once)
  status         Is everything running, and has everything reached Google Drive?
  logs [-f]      Show the service log (-f to keep following it)
  password       Show the backup password (needed to restore on another Mac)
  reconnect      Sign in to Google again (if the sign-in expired)
  restart        Restart the background service (after editing settings)
  stop | start   Stop or start the background service
  uninstall      Remove the service and the Time Machine disk (your backups stay in Drive)
      --purge      Also delete the settings, the backup password and the cache
  version        Print the version

Settings: $CONFIG_FILE
Log:      $LOG_FILE
Docs:     https://github.com/$REPO
EOF
}

main() {
    local cmd="${1:-help}"
    [[ $# -gt 0 ]] && shift
    case "$cmd" in
        setup|status|start|stop|restart|reconnect|password|uninstall|daemon|logs)
            "cmd_$cmd" "$@" ;;
        version|--version|-v) echo "$PROG $VERSION" ;;
        help|--help|-h) usage ;;
        *) usage >&2; exit 1 ;;
    esac
}

[[ -n "$TM2GDRIVE_SOURCE_ONLY" ]] || main "$@"
