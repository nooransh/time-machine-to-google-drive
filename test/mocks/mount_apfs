#!/bin/bash
# Fake: "mount" a snapshot by replacing the mount point with a symlink.
snap="" ; while getopts "o:s:" opt; do case $opt in s) snap="$OPTARG";; *) ;; esac; done
shift $((OPTIND - 1)); mnt="$2"  # $1 is the device
src="$FAKE_ROOT/snapshots/$snap"
[[ -d "$src" ]] || { echo "mount_apfs: snapshot $snap not found" >&2; exit 1; }
[[ -L "$mnt" ]] && { echo "mount_apfs: busy" >&2; exit 1; }
rmdir "$mnt" && ln -s "$src" "$mnt"
echo "$snap" >> "$FAKE_ROOT/mount.log"
