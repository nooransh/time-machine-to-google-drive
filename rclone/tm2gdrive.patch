+// freshObject returns f.o, looked up again at p (the file's current
+// remote path) if a parent directory was renamed after the file was
+// uploaded: f.o still has the old path then, so moving or removing it
+// would fail.
+func (f *File) freshObject(ctx context.Context, p string) fs.Object {
+	f.mu.RLock()
+	o, d := f.o, f.d
+	f.mu.RUnlock()
+	if o == nil || o.Remote() == p {
+		return o
+	}
+	fresh, err := d.Fs().NewObject(ctx, p)
+	if err != nil {
+		fs.Debugf(p, "Couldn't find object after directory rename: %v", err)
+		return o
+	}
+	f.mu.Lock()
+	if f.o == o {
+		f.o = fresh
+	}
+	f.mu.Unlock()
+	return fresh
+}
