+	writeCalled bool       // if any Write() methods have been called
+	writing     int        // number of writes in progress with mu unlocked
+	writeDone   *sync.Cond // signalled when a write in progress finishes
+}
+
+// _waitForWrites waits until no writes are in progress, so closing
+// the handle doesn't fail writes which are still running (they can
+// be paused by --vfs-cache-max-pending).
+//
+// Call with fh.mu held.
+func (fh *RWFileHandle) _waitForWrites() {
+	for fh.writing > 0 {
+		fh.writeDone.Wait()
+	}
