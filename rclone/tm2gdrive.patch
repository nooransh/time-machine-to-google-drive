index ca79f22..5369770 100644
--- a/vfs/vfscache/cache.go
+++ b/vfs/vfscache/cache.go
@@ -161,6 +161,8 @@ func (c *Cache) Stats() (out rc.Params) {
 	uploadsInProgress, uploadsQueued := c.writeback.Stats()
 	out["uploadsInProgress"] = uploadsInProgress
 	out["uploadsQueued"] = uploadsQueued
+	out["dirtyFiles"], out["dirtyBytes"] = c.dirtyStats(true)
+	out["pendingFiles"], out["pendingBytes"] = c.dirtyStats(false)
 
 	c.mu.Lock()
 	defer c.mu.Unlock()
@@ -877,6 +879,50 @@ func (c *Cache) cleaner(ctx context.Context) {
 	}
 }
 
+// dirtyStats returns the number and total size of the files which
+// haven't been uploaded yet. Files which are still open are only
+// counted if includeOpen is set.
+func (c *Cache) dirtyStats(includeOpen bool) (files int, bytes int64) {
+	c.mu.Lock()
+	items := make([]*Item, 0, len(c.item))
+	for _, item := range c.item {
+		items = append(items, item)
+	}
+	c.mu.Unlock()
+	for _, item := range items {
+		item.mu.Lock()
+		if item.info.Dirty && (includeOpen || item.opens == 0) {
+			files++
+			bytes += item.info.Size
+		}
+		item.mu.Unlock()
+	}
+	return files, bytes
+}
+
+// waitForUploads blocks while more than --vfs-cache-max-pending of
+// closed files are waiting to be uploaded, so that writers slow down
+// to the upload speed instead of filling the disk.
+//
+// Files which are still open don't count, as they can't be uploaded
+// until they are closed.
+func (c *Cache) waitForUploads() {
+	limit := int64(c.opt.CacheMaxPending)
+	if limit <= 0 {
+		return
+	}
+	for {
+		if _, pending := c.dirtyStats(false); pending <= limit {
+			return
+		}
+		select {
+		case <-c.ctx.Done():
+			return
+		case <-time.After(250 * time.Millisecond):
+		}
+	}
+}
+
